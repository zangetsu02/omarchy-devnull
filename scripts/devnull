#!/usr/bin/env python3
"""dev-null.sh from the Omarchy bar.

Usage: devnull <command> [arguments]

  me                     who the paired key signs in as, and the unread count
  pair <code> <verifier> redeem an authorization code; writes device.json
  feed [--log L] [--cursor C]
                         a log (latest, following, trending), 20 commits and the cursor for the next
  notifications [--type replies,mentions,…]
                         what happened to you — THIS MARKS THEM READ everywhere
  star <id>              star a commit
  unstar <id>            take the star back
  reply <id> <body>      reply to a commit; the answer says whether it is live
  mute <user>            stop seeing someone, without telling them
  unmute <user>          undo that
  block <user>           block someone both ways
  unblock <user>         undo that
  report <id>            send a commit to the moderators
  pastel <id>            give a commit one of your pastéis for today
  pasteis-mode on|off    turn pastéis mode on or off
  muted                  who you muted
  blocked                who you blocked
  delete <id>            take back one of your own commits
  vote <id> <option>     vote in a commit's poll
  preview <body>         how the site will render a body, before you send it
  group <notification>   everyone behind one grouped notification
  lane 0-5|#rrggbb|auto  your colour on the graph
  sync-github            pull your name, bio and avatar from GitHub again
  github-key             which of your public keys dev-null already knows
  delete-account <user>  delete your account, naming it to mean it
  replies <id> [--cursor C]
                         the direct replies to a commit, oldest first
  commit <body> [--quote <id>]
                         a new commit on the log, or a quote of <id>
  show <id>              a commit, after the commits it replies to
  user <name>            a profile
  standing <name>        its level, achievements, commit activity and streaks
  user-commits|followers|following <name> [--cursor C]
                         a profile's commits, or the people around it
  starred [--cursor C]   the commits you starred
  follow|unfollow <name> follow someone, or stop

Every command prints one JSON object on stdout. A failure prints
{"error": "<line>", "kind": "<kind>"} and exits 1 — never a traceback.

Requests are signed with an SSH key kept in ~/.local/share/omarchy-devnull,
in the "devnull-api" namespace, which is the only thing that signature is
good for: it cannot sign a git commit or log in anywhere.
"""

import html
import json
import os
import re
import secrets
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

NAMESPACE = "devnull-api"
BASE_URL = os.environ.get("DEVNULL_URL", "https://dev-null.sh").rstrip("/")
HOME = Path(os.environ.get("DEVNULL_HOME", Path.home() / ".local/share/omarchy-devnull"))
KEY = HOME / "id_ed25519"
TIMEOUT = 15


def plugin_version():
    """The manifest's version, so the User-Agent never drifts from the release."""
    try:
        manifest = Path(__file__).resolve().parent.parent / "manifest.json"
        return json.loads(manifest.read_text()).get("version", "dev")
    except (OSError, ValueError):
        return "dev"


# Cloudflare in front of dev-null.sh bans urllib's default agent (error 1010).
USER_AGENT = f"omarchy-devnull/{plugin_version()}"

# Only device_not_approved means the pairing is gone. invalid_signature shares
# its 401 and usually means the clock is off, which re-pairing would not fix.
# device_not_approved is the one kind that depends on local state: the same
# refusal means "revoked" to a machine that was paired and "never finished the
# setup" to one that was not.
KINDS = {
    "invalid_signature": "expired",
    "commit_rules_required": "rules",
    "rate_limited": "limited",
    # Nothing is broken: the day's allowance is simply spent.
    "pasteis_exhausted": "exhausted",
}


class BridgeError(Exception):
    def __init__(self, message, kind="http"):
        super().__init__(message)
        self.kind = kind


def signed_message(timestamp, nonce, method, uri, body):
    """The five fields the server joins and checks, in its order."""
    return "\n".join([timestamp, nonce, method, uri, body])


def new_nonce():
    return secrets.token_hex(16)


def sign(message, key_path=None):
    """An armored SSH signature over the message, in the devnull-api namespace."""
    key_path = Path(key_path or KEY)
    if not key_path.exists():
        # Never connected is not a refused device: the panel offers the
        # connection rather than telling anyone something broke.
        raise BridgeError("This machine has never been connected to dev-null. "
                          "Run scripts/setup-devnull.", "unpaired")
    old_umask = os.umask(0o077)
    try:
        with tempfile.TemporaryDirectory() as tmp:
            payload = Path(tmp) / "message"
            payload.write_text(message)
            result = subprocess.run(
                ["ssh-keygen", "-Y", "sign", "-n", NAMESPACE, "-f", str(key_path), str(payload)],
                capture_output=True, text=True,
            )
            if result.returncode != 0:
                raise BridgeError(result.stderr.strip() or "ssh-keygen could not sign.", "auth")
            return (Path(tmp) / "message.sig").read_text()
    finally:
        os.umask(old_umask)


def header_signature(armored):
    """An armored signature has newlines; a header cannot. The server accepts the
    base64 body on one line, which is what the markers and whitespace leave."""
    return re.sub(r"\s+|-----(BEGIN|END) SSH SIGNATURE-----", "", armored)


def ever_paired():
    """Whether a pairing ever finished here. `pair` writes device.json last, so
    a key without it means the setup was started and never approved."""
    return (HOME / "device.json").exists()


def classify(status, code, message, paired=None):
    """Which kind of failure this is. The body's code decides, not the status.

    `paired` is whether a pairing ever finished here; the same refusal means a
    revoked device to a machine that was paired and an unfinished setup to one
    that was not. It is a parameter so this stays a pure function.
    """
    if paired is None:
        paired = ever_paired()
    if status is None:
        return "network"
    if code == "device_not_approved":
        return "auth" if paired else "unpaired"
    if code in KINDS:
        return KINDS[code]
    if "signature expired" in (message or "").lower():
        return "expired"
    if status == 401:
        return "auth" if paired else "unpaired"
    return "http"


def call(method, path, body=None):
    """One signed request. `path` is signed exactly as sent, query included."""
    payload = "" if body is None else json.dumps(body, separators=(",", ":"))
    data = payload.encode() if payload else None
    timestamp = str(int(time.time()))
    nonce = new_nonce()
    signature = sign(signed_message(timestamp, nonce, method, path, payload))

    headers = {
        "X-Devnull-Timestamp": timestamp,
        "X-Devnull-Nonce": nonce,
        "X-SSH-Signature": header_signature(signature),
        "Accept": "application/json",
        "User-Agent": USER_AGENT,
    }
    if data:
        headers["Content-Type"] = "application/json"

    request = urllib.request.Request(BASE_URL + path, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            raw = response.read().decode()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as error:
        raw = error.read().decode(errors="replace")
        try:
            answer = json.loads(raw)
        except ValueError:
            answer = {}
        message = answer.get("message") or answer.get("error") or error.reason
        raise BridgeError(message, classify(error.code, answer.get("code"), message)) from error
    except urllib.error.URLError as error:
        raise BridgeError(str(error.reason), "network") from error


def cmd_me():
    return call("GET", "/api/v1/me")


LOGS = ("latest", "following", "trending")


def paged(args):
    """Pulls --cursor out of the arguments; the rest come back untouched."""
    args, cursor = list(args), None
    if "--cursor" in args:
        at = args.index("--cursor")
        cursor = args[at + 1]
        del args[at:at + 2]
    return args, cursor


def page(path, cursor):
    """A Laravel resource page as {items, next_cursor}. The cursor is part of the
    signed URI, so it goes on the path."""
    if cursor:
        path += "?" + urllib.parse.urlencode({"cursor": cursor})
    answer = call("GET", path)
    return answer.get("data", []), answer.get("meta", {}).get("next_cursor") or answer.get("next_cursor")


def public_feed():
    """The Latest log with no key at all.

    dev-null is server rendered, so its home page carries the whole log as JSON
    in its Inertia props. The page names things differently from the API — the
    author is `user`, and there is no short_hash or html_url — so those are
    derived here the way CommitResource derives them, and one shape reaches the
    panel whichever door the commits came through.
    """
    request = urllib.request.Request(
        BASE_URL + "/", headers={"Accept": "text/html", "User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            page_html = response.read().decode(errors="replace")
    except urllib.error.HTTPError as error:
        # A refusal from the site is not a dead network, and must not read as one.
        message = f"dev-null answered {error.code} for its home page."
        raise BridgeError(message, classify(error.code, None, message)) from error
    except urllib.error.URLError as error:
        raise BridgeError(str(getattr(error, "reason", error)), "network") from error

    found = re.search(r'data-page="app" type="application/json">(.*?)</script>',
                      page_html, re.S)
    if not found:
        raise BridgeError("dev-null's home page did not carry its feed.", "http")
    try:
        commits = json.loads(found.group(1))["props"]["commits"]
    except (ValueError, KeyError) as error:
        raise BridgeError(f"Could not read the public feed: {error}", "http") from error

    return {
        "commits": [normalize_public(c) for c in commits.get("data", [])],
        "next_cursor": commits.get("next_cursor"),
        "public": True,
    }


def normalize_public(commit):
    """What CommitResource would have sent, from what the page carries.

    The page names the author `user` at EVERY depth, so this owns the nested
    commits too: a reply preview or a quote left unconverted draws as "@?".
    """
    if not commit:
        return commit
    author = commit.get("user") or commit.get("author") or {}
    plain = str(commit.get("id") or "").replace("-", "")
    short = plain[-7:] if len(plain) >= 7 else plain
    out = dict(commit)
    out["author"] = author
    out.setdefault("short_hash", short)
    if not out.get("html_url") and author.get("username") and short:
        out["html_url"] = f"{BASE_URL}/@{author['username']}/commits/{short}"

    if out.get("quoted_commit"):
        out["quoted_commit"] = normalize_public(out["quoted_commit"])
    preview = out.get("reply_preview") or {}
    if preview.get("data"):
        out["reply_preview"] = dict(
            preview, data=[normalize_public(reply) for reply in preview["data"]])
    return out


def cmd_feed(*args):
    """A log: latest (default), following or trending. --public needs no key."""
    if "--public" in args:
        return public_feed()
    args, cursor = paged(args)
    log = "latest"
    if len(args) == 2 and args[0] == "--log":
        log = args[1]
    if log not in LOGS:
        raise BridgeError(f"No log called {log!r}.", "http")
    commits, cursor = page(f"/api/v1/log/{log}", cursor)
    return {"commits": commits, "next_cursor": cursor}


def cmd_replies(commit_id, *args):
    """The direct replies to one commit, oldest first, as the site shows a thread."""
    _, cursor = paged(args)
    replies, cursor = page(f"/api/v1/commits/{commit_id}/replies", cursor)
    return {"replies": replies, "next_cursor": cursor}


def listing(path):
    """A command for one paged list: {items, next_cursor}, like every other list."""
    def command(*args):
        _, cursor = paged(args)
        items, cursor = page(path, cursor)
        return {"items": items, "next_cursor": cursor}
    return command


def per_user(template):
    """A paged list that hangs off one user, e.g. /users/{u}/commits."""
    def command(username, *args):
        return listing(template.format(username=urllib.parse.quote(username)))(*args)
    return command


def cmd_show(commit_id):
    """A commit with the conversation above it, as one list: its ancestors,
    oldest first, then the commit itself last — the shape every list has."""
    answer = call("GET", f"/api/v1/commits/{urllib.parse.quote(commit_id)}")
    return {"items": answer.get("ancestors", []) + [answer.get("data", {})], "next_cursor": None}


# Level, achievements and commit activity are not in the API: the site draws
# them from the profile page's own data, which an Inertia page embeds in its
# HTML. That page is public, so this request is not signed.
PAGE_DATA = re.compile(r'<script data-page="app" type="application/json">(.*?)</script>', re.S)


def cmd_standing(username):
    """A profile's level, rank, XP, achievements, commit activity and streaks."""
    request = urllib.request.Request(
        f"{BASE_URL}/@{urllib.parse.quote(username)}",
        headers={"Accept": "text/html", "User-Agent": USER_AGENT},
    )
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            page = response.read().decode()
    except urllib.error.HTTPError as error:
        raise BridgeError(error.reason, classify(error.code, None, error.reason)) from error
    except urllib.error.URLError as error:
        raise BridgeError(str(error.reason), "network") from error
    match = PAGE_DATA.search(page)
    if not match:
        raise BridgeError("The profile page has changed shape; standing is unavailable.", "http")
    props = json.loads(html.unescape(match.group(1))).get("props", {})
    return {
        "achievements": props.get("achievements") or {},
        "activity": props.get("activity") or {},
        "streaks": props.get("streaks") or {},
    }


def cmd_user(username):
    return call("GET", f"/api/v1/users/{urllib.parse.quote(username)}").get("data", {})


def cmd_follow(username):
    # The route answers 204: what changed is what was asked.
    call("POST", f"/api/v1/users/{urllib.parse.quote(username)}/follow")
    return {"username": username, "is_followed": True}


def cmd_unfollow(username):
    call("DELETE", f"/api/v1/users/{urllib.parse.quote(username)}/follow")
    return {"username": username, "is_followed": False}


# The kinds upstream will filter by, from ListNotificationsRequest::TYPE_RULE.
NOTIFICATION_TYPES = ("replies", "quotes", "stars", "mentions", "follows", "moderation")


def cmd_notifications(*args):
    """Listing marks every notification read, upstream, for the web and the app
    too. Only call this when the panel is opened, never on a timer.

    The server remembers a chosen filter in a cookie, which this does not send,
    so the type goes on every request or it is forgotten."""
    path = "/api/v1/notifications"
    if len(args) == 2 and args[0] == "--type":
        wanted = args[1]
        if wanted not in ("all", "none"):
            for kind in wanted.split(","):
                if kind not in NOTIFICATION_TYPES:
                    raise BridgeError(
                        f"No notification kind called {kind!r}. "
                        f"One or more of: {', '.join(NOTIFICATION_TYPES)}.", "http")
        path += "?" + urllib.parse.urlencode({"type": wanted})
    answer = call("GET", path)
    return {"notifications": answer.get("data", []), "read_at": answer.get("read_at")}


def cmd_star(commit_id):
    # The star routes answer with the whole commit, as a CommitResource.
    return call("POST", f"/api/v1/commits/{commit_id}/star").get("data", {})


def cmd_unstar(commit_id):
    return call("DELETE", f"/api/v1/commits/{commit_id}/star").get("data", {})


def cmd_reply(commit_id, body):
    """The body goes as typed: length and emptiness are the server's rules, and its
    refusal is more useful than a guess made here."""
    answer = call("POST", "/api/v1/commits", {"body": body, "parent_id": commit_id})
    return answer.get("data", answer)


def cmd_commit(body, *args):
    """A new commit on the log, or a quote of another one with --quote <id>."""
    payload = {"body": body}
    if len(args) == 2 and args[0] == "--quote":
        payload["quoted_commit_id"] = args[1]
    answer = call("POST", "/api/v1/commits", payload)
    return answer.get("data", answer)


def cmd_mute(username):
    return call("POST", f"/api/v1/users/{username}/mute")


def cmd_unmute(username):
    return call("DELETE", f"/api/v1/users/{username}/mute")


def cmd_block(username):
    return call("POST", f"/api/v1/users/{username}/block")


def cmd_unblock(username):
    return call("DELETE", f"/api/v1/users/{username}/block")


def cmd_report(commit_id):
    """A commit that is gone answers the same as one you may not see, upstream,
    so a report cannot be used to find out what exists."""
    return call("POST", f"/api/v1/commits/{commit_id}/reports")


def cmd_pastel(commit_id):
    """One pastel out of the day's allowance. The answer carries how many are
    left, so the panel can stop offering one that would be refused."""
    answer = call("POST", f"/api/v1/commits/{commit_id}/pasteis")
    commit = answer.get("data", {})
    return {
        "pasteis_count": commit.get("pasteis_count"),
        "pasteis_remaining": answer.get("pasteis_remaining"),
        "pasteis_resets_at": answer.get("pasteis_resets_at"),
    }


def cmd_pasteis_mode(state):
    if state not in ("on", "off"):
        raise BridgeError(f"Pastéis mode is on or off, not {state!r}.", "http")
    return call("PUT", "/api/v1/me/pasteis-mode", {"enabled": state == "on"})


def cmd_muted():
    return {"users": call("GET", "/api/v1/me/muted").get("data", [])}


def cmd_blocked():
    return {"users": call("GET", "/api/v1/me/blocked").get("data", [])}


def cmd_delete(commit_id):
    """Yours to take back. The server answers with no content."""
    return call("DELETE", f"/api/v1/commits/{commit_id}") or {"deleted": commit_id}


def cmd_vote(commit_id, option):
    """The option's id, not its position: a poll's options are uuids."""
    return call("POST", f"/api/v1/commits/{commit_id}/poll/votes", {"option": option})


def cmd_preview(body):
    """Highlighting and resolving mentions happen on the server, so a composer
    that wants to show either has to ask."""
    return call("POST", "/api/v1/commits/preview", {"body": body})


def cmd_group(notification_id):
    return call("GET", f"/api/v1/notifications/{notification_id}/group")


# The six lanes dev-null draws its graph in; `auto` gives the choice back.
def cmd_lane(value):
    if value == "auto":
        return call("PUT", "/api/v1/me/lane", {"lane": None})
    if re.fullmatch(r"#[0-9a-f]{6}", value):
        return call("PUT", "/api/v1/me/lane", {"color": value})
    if re.fullmatch(r"[0-5]", value):
        return call("PUT", "/api/v1/me/lane", {"lane": int(value)})
    raise BridgeError(f"A lane is 0 to 5, a #rrggbb colour, or auto, not {value!r}.", "http")


def cmd_sync_github():
    """Your name, bio and avatar, mirrored from GitHub again. Throttled to one
    a minute upstream."""
    return call("PUT", "/api/v1/me/github")


def public_keys():
    """Your public keys: the agent's first, then the ones in ~/.ssh. Public
    keys are public; no private key is ever read or sent."""
    keys = []
    agent = subprocess.run(["ssh-add", "-L"], capture_output=True, text=True)
    if agent.returncode == 0:
        keys += [line for line in agent.stdout.splitlines() if line.startswith("ssh-")]
    ssh_dir = Path(os.environ.get("DEVNULL_SSH_DIR", Path.home() / ".ssh"))
    for path in sorted(ssh_dir.glob("*.pub")):
        try:
            line = path.read_text().strip()
        except OSError:
            continue
        if line.startswith("ssh-") and line not in keys:
            keys.append(line)
    return keys


def cmd_github_key():
    """Asks dev-null which of your public keys it already knows, the way the
    `/commit` script does before it signs. Unsigned, and the body is the keys
    as plain text: this endpoint takes no JSON."""
    keys = public_keys()
    if not keys:
        return {"known": False, "key": "", "offered": 0}

    body = ("\n".join(keys) + "\n").encode()
    request = urllib.request.Request(
        BASE_URL + "/api/cli/key-lookups", data=body,
        headers={"Content-Type": "text/plain", "User-Agent": USER_AGENT}, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            found = response.read().decode(errors="replace").strip()
    except urllib.error.HTTPError as error:
        message = f"dev-null answered {error.code} for the key lookup."
        raise BridgeError(message, classify(error.code, None, message)) from error
    except urllib.error.URLError as error:
        raise BridgeError(str(getattr(error, "reason", error)), "network") from error

    return {"known": found != "", "key": found, "offered": len(keys)}


def cmd_delete_account(username):
    """Deletes the account and every device with it, so this key stops working
    at once. The username is typed again because nothing here can be undone."""
    device = {}
    try:
        device = json.loads((HOME / "device.json").read_text())
    except (OSError, ValueError):
        pass
    mine = device.get("username") or ""
    if not mine or username != mine:
        raise BridgeError(
            f"Name the account to delete it. This machine is paired as "
            f"{mine or 'nothing'!r}.", "http")
    call("DELETE", "/api/v1/me")
    return {"deleted": mine}


def cmd_pair(code, verifier):
    """Redeem a code for a device. The key signing this is the one being approved."""
    answer = call("POST", "/api/v1/devices", {"code": code, "code_verifier": verifier})
    fingerprint = subprocess.run(
        ["ssh-keygen", "-lf", str(KEY)], capture_output=True, text=True, check=True
    ).stdout.split()[1]
    device = {
        "username": answer.get("username") or answer.get("data", {}).get("username"),
        "fingerprint": fingerprint,
    }
    HOME.mkdir(parents=True, exist_ok=True)
    (HOME / "device.json").write_text(json.dumps(device, indent=1) + "\n")
    return device


COMMANDS = {"me": cmd_me, "pair": cmd_pair, "feed": cmd_feed,
            "notifications": cmd_notifications, "star": cmd_star,
            "unstar": cmd_unstar, "reply": cmd_reply, "replies": cmd_replies,
            "commit": cmd_commit, "show": cmd_show, "user": cmd_user,
            "standing": cmd_standing, "follow": cmd_follow,
            "unfollow": cmd_unfollow, "starred": listing("/api/v1/starred"),
            "user-commits": per_user("/api/v1/users/{username}/commits"),
            "followers": per_user("/api/v1/users/{username}/followers"),
            "following": per_user("/api/v1/users/{username}/following"),
            "mute": cmd_mute, "unmute": cmd_unmute,
            "block": cmd_block, "unblock": cmd_unblock,
            "report": cmd_report, "pastel": cmd_pastel,
            "pasteis-mode": cmd_pasteis_mode,
            "muted": cmd_muted, "blocked": cmd_blocked,
            "delete": cmd_delete, "vote": cmd_vote, "preview": cmd_preview,
            "group": cmd_group, "lane": cmd_lane, "sync-github": cmd_sync_github,
            "github-key": cmd_github_key, "delete-account": cmd_delete_account}


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] not in COMMANDS:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        print(json.dumps(COMMANDS[argv[0]](*argv[1:])))
        return 0
    except BridgeError as error:
        print(json.dumps({"error": str(error), "kind": error.kind}))
        return 1
    except Exception as error:  # the panel gets a line, not a traceback
        print(json.dumps({"error": f"{type(error).__name__}: {error}", "kind": "http"}))
        return 1


if __name__ == "__main__":
    sys.exit(main())
