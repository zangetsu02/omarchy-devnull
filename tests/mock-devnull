#!/usr/bin/env python3
"""A stand-in for dev-null.sh, so the bridge can be tested without the real site.

It mirrors the shapes the real API returns — a Laravel resource collection with
its `data` and `meta.next_cursor` — and enforces the parts of the protocol that
matter: the three signature headers must be there, and a nonce is spent once.

Run it directly to poke at it by hand, or import `start()` from a test.
"""

import json
import re
import threading
from http.server import BaseHTTPRequestHandler, HTTPServer

CURSOR = "eyJpZCI6..."

COMMITS = [
    {"id": "01a15d37-0511-7071-a1ae-d28a502b4a24", "short_hash": "d453634",
     "body": "I built chorei, a tool that helps me prepare my daily standup.",
     "author": {"username": "zangetsu02", "name": "christian"},
     "stars_count": 4, "starred": False, "status": "approved", "replies_count": 1,
     "created_at": "2026-10-21T07:12:00.000000Z",
     "html_url": "https://dev-null.sh/@zangetsu02/commits/01a15d37"},
    {"id": "01a15d76-9c69-7123-bd48-48dc6b82dce4", "short_hash": "36795c7",
     "body": "", "author": {"username": "ndk98z", "name": "Khanhz"},
     "stars_count": 0, "starred": True, "status": "approved", "replies_count": 0,
     "created_at": "2026-10-21T07:05:00.000000Z",
     "html_url": "https://dev-null.sh/@ndk98z/commits/01a15d76"},
]

NOTIFICATIONS = [
    {"id": "n1", "type": "replied", "read_at": None,
     "actor": {"username": "pptx704"}, "commit": {"short_hash": "d453634", "body": "Seems like github pages tho"}},
]


class State:
    def __init__(self):
        self.calls = []
        self.last_uri = None
        self.last_method = None
        self.last_body = None
        self.notifications_calls = 0
        self.spent_nonces = set()
        self.signature_covered_body = False
        self.next_response = None
        self.next_status = None
        self.stars = {c["id"]: c["starred"] for c in COMMITS}


def handler_for(state):
    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *args):
            pass

        def reply(self, status, payload):
            body = json.dumps(payload).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def signed(self):
            """The three headers, well-formed, and a nonce that was never used."""
            timestamp = self.headers.get("X-Devnull-Timestamp", "")
            nonce = self.headers.get("X-Devnull-Nonce", "")
            signature = self.headers.get("X-SSH-Signature", "")
            if not (timestamp.isdigit() and re.fullmatch(r"[0-9a-f]{32}", nonce) and signature):
                self.reply(401, {"code": "invalid_signature", "message": "Malformed payload."})
                return False
            if nonce in state.spent_nonces:
                self.reply(400, {"code": "invalid_signature", "message": "Replayed nonce."})
                return False
            state.spent_nonces.add(nonce)
            return True

        def read_body(self):
            length = int(self.headers.get("Content-Length") or 0)
            return self.rfile.read(length).decode() if length else ""

        def record(self, body=""):
            state.calls.append(self.path.split("?")[0])
            state.last_uri = self.path
            state.last_method = self.command
            state.last_body = body
            state.signature_covered_body = bool(body) and bool(self.headers.get("X-SSH-Signature"))

        def forced(self):
            """A canned answer a test asked for, used once."""
            if state.next_status or state.next_response:
                status = state.next_status or 200
                payload = state.next_response or {}
                state.next_status = state.next_response = None
                self.reply(status, payload)
                return True
            return False

        def do_GET(self):
            if not self.signed():
                return
            self.record()
            if self.forced():
                return
            path = self.path.split("?")[0]
            if path == "/api/v1/me":
                self.reply(200, {"data": {"username": "zangetsu02"},
                                 "unread_notifications_count": 3})
            elif path == "/api/v1/log/latest":
                self.reply(200, {"data": COMMITS, "meta": {"next_cursor": CURSOR}})
            elif path == "/api/v1/notifications":
                state.notifications_calls += 1
                self.reply(200, {"data": NOTIFICATIONS, "read_at": "2026-10-21T08:00:00Z"})
            else:
                self.reply(404, {"message": "Not Found."})

        def do_POST(self):
            if not self.signed():
                return
            body = self.read_body()
            self.record(body)
            if self.forced():
                return
            path = self.path.split("?")[0]
            star = re.fullmatch(r"/api/v1/commits/([^/]+)/star", path)
            if star:
                state.stars[star.group(1)] = True
                self.reply(200, {"starred": True, "stars_count": 5})
            elif path == "/api/v1/commits":
                sent = json.loads(body)
                self.reply(201, {"data": {"id": "new", "short_hash": "aaaaaaa",
                                          "status": "pending", "body": sent["body"]}})
            elif path == "/api/v1/devices":
                self.reply(200, {"username": "zangetsu02"})
            else:
                self.reply(404, {"message": "Not Found."})

        def do_DELETE(self):
            if not self.signed():
                return
            self.record()
            if self.forced():
                return
            star = re.fullmatch(r"/api/v1/commits/([^/]+)/star", self.path.split("?")[0])
            if star:
                state.stars[star.group(1)] = False
                self.reply(200, {"starred": False, "stars_count": 4})
            else:
                self.reply(404, {"message": "Not Found."})

    return Handler


def start():
    """Returns (state, url, stop)."""
    state = State()
    server = HTTPServer(("127.0.0.1", 0), handler_for(state))
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return state, f"http://127.0.0.1:{server.server_port}", server.shutdown


if __name__ == "__main__":
    state, url, _ = start()
    print(f"mock dev-null on {url}")
    threading.Event().wait()
