#!/usr/bin/env python3
"""The read half of the bridge, against the mock. Run with: tests/read-test"""

import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
BRIDGE = HERE.parent / "scripts" / "devnull"

spec = importlib.util.spec_from_loader(
    "mock_devnull", importlib.machinery.SourceFileLoader("mock_devnull", str(HERE / "mock-devnull"))
)
mock_module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mock_module)


def main():
    tmp = tempfile.TemporaryDirectory()
    home = Path(tmp.name)
    subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "t",
                    "-f", str(home / "id_ed25519")], check=True)
    # A machine that finished pairing: `pair` writes this last, and the bridge
    # reads it to tell a revoked device from a setup that never got approved.
    (home / "device.json").write_text('{"username": "zangetsu02"}')
    state, url, stop = mock_module.start((home / "id_ed25519.pub").read_text())
    environment = dict(os.environ, DEVNULL_URL=url, DEVNULL_HOME=str(home))

    def run(*args):
        result = subprocess.run([str(BRIDGE), *args], capture_output=True, text=True,
                                env=environment)
        return json.loads(result.stdout or "{}"), result.returncode

    def run_in(home_dir, *args):
        """Same, with a state directory that holds no key at all."""
        result = subprocess.run([str(BRIDGE), *args], capture_output=True, text=True,
                                env=dict(environment, DEVNULL_HOME=home_dir))
        return json.loads(result.stdout or "{}"), result.returncode

    try:
        # The feed comes back as a list, newest first, with the fields the panel needs.
        feed, code = run("feed")
        assert code == 0, feed
        assert [c["short_hash"] for c in feed["commits"]] == ["d453634", "36795c7"]
        assert feed["next_cursor"] == mock_module.CURSOR
        assert feed["commits"][0]["author"]["username"] == "zangetsu02"
        assert feed["commits"][0]["html_url"].startswith("https://dev-null.sh/")

        # A second page is asked for with the cursor, on the query string that got signed.
        run("feed", "--cursor", mock_module.CURSOR)
        assert state.last_uri == f"/api/v1/log/latest?cursor={mock_module.CURSOR}"

        # The other two logs are the same call on their own route.
        run("feed", "--log", "trending")
        assert state.last_uri == "/api/v1/log/trending"
        run("feed", "--log", "following", "--cursor", mock_module.CURSOR)
        assert state.last_uri == f"/api/v1/log/following?cursor={mock_module.CURSOR}"
        # A log the site does not have is refused here, not sent.
        calls = len(state.calls)
        answer, code = run("feed", "--log", "everyone")
        assert code == 1 and len(state.calls) == calls

        # A thread is the replies route of its commit.
        thread, code = run("replies", "c1")
        assert code == 0 and thread["replies"][0]["author"]["username"] == "pptx704"
        assert state.last_uri == "/api/v1/commits/c1/replies"

        # A commit comes after the commits it replies to, as one list.
        page, code = run("show", "r1")
        assert code == 0 and state.last_uri == "/api/v1/commits/r1"
        assert [c["short_hash"] for c in page["items"]] == ["d453634", "0000001"]

        # Standing comes from the public profile page, unsigned, as one object.
        standing, code = run("standing", "pptx704")
        assert code == 0 and state.last_uri == "/@pptx704", standing
        assert standing["achievements"]["rank"] == "operator"
        assert standing["activity"]["buckets"][0]["count"] == 2
        assert standing["streaks"]["current"] == 1

        # A profile, and every list around it, in the same {items, next_cursor} shape.
        user, code = run("user", "pptx704")
        assert code == 0 and user["username"] == "pptx704"
        assert state.last_uri == "/api/v1/users/pptx704"
        for command, route in (("user-commits", "commits"), ("followers", "followers"), ("following", "following")):
            answer, code = run(command, "pptx704")
            assert code == 0 and len(answer["items"]) > 0, answer
            assert state.last_uri == f"/api/v1/users/pptx704/{route}"
        starred, code = run("starred", "--cursor", mock_module.CURSOR)
        assert code == 0 and starred["next_cursor"] == mock_module.CURSOR
        assert state.last_uri == f"/api/v1/starred?cursor={mock_module.CURSOR}"

        # `me` does not touch notifications — the whole point of the design.
        before = state.notifications_calls
        me, code = run("me")
        assert code == 0 and me["unread_notifications_count"] == 3
        assert state.notifications_calls == before

        # `notifications` does, once, and hands back the boundary.
        notifications, code = run("notifications")
        assert code == 0
        assert state.notifications_calls == before + 1
        assert notifications["read_at"].endswith("Z")
        assert notifications["notifications"][0]["type"] == "replied"

        # Every call signs with a fresh nonce: the mock refuses a replayed one.
        assert len(state.spent_nonces) == len(state.calls)

        # A failure is one JSON line with a kind, never a traceback.
        state.next_status = 401
        state.next_response = {"code": "device_not_approved", "message": "Not approved."}
        answer, code = run("me")
        assert code == 1 and answer["kind"] == "auth" and answer["error"] == "Not approved."

        # Notifications can be narrowed to the kinds upstream knows. The server
        # remembers the choice in a cookie we do not send, so it goes on every
        # request or it is forgotten.
        run("notifications", "--type", "replies,mentions")
        assert state.last_uri == "/api/v1/notifications?type=replies%2Cmentions", state.last_uri
        run("notifications")
        assert state.last_uri == "/api/v1/notifications", state.last_uri
        # A kind the server does not know is refused here rather than silently
        # becoming "all", which is what upstream would do with it.
        answer, code = run("notifications", "--type", "gossip")
        assert code == 1 and "gossip" in answer["error"], answer

        # The public feed: no key, no signature, the same shape as the API one.
        public, code = run_in(tempfile.gettempdir() + "/devnull-nokey", "feed", "--public")
        assert code == 0, public
        assert public["commits"][0]["short_hash"] == "02b4a24"
        assert public["commits"][0]["author"]["username"] == "zangetsu02"
        assert public["commits"][0]["html_url"].endswith("/@zangetsu02/commits/02b4a24")
        assert public["next_cursor"] == mock_module.CURSOR
        # The page names the author `user` at every depth. An adapter that
        # converts only the top level leaves every inline reply drawing "@?".
        first = public["commits"][0]
        reply = first["reply_preview"]["data"][0]
        assert reply["author"]["username"] == "pptx704", reply
        assert reply["short_hash"] == reply["id"].replace("-", "")[-7:], reply["short_hash"]
        assert reply["html_url"].endswith("/@pptx704/commits/" + reply["short_hash"])
        quoted = first["quoted_commit"]
        assert quoted["author"]["username"] == "ndk98z", quoted
        assert quoted["short_hash"] and quoted["html_url"]

        # It really went unsigned: it never joined the signed-call list.
        assert state.public_calls == 1
        assert state.last_uri == "/"

        # A key the setup made but never got approved is NOT "paired any more":
        # it was never paired at all. device.json is written only by a pairing
        # that finished, so its absence is what tells the two apart.
        half = tempfile.TemporaryDirectory()
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "t",
                        "-f", str(Path(half.name) / "id_ed25519")], check=True)
        state.next_status = 401
        state.next_response = {"code": "device_not_approved", "message": "This key isn't approved."}
        answer, code = run_in(half.name, "me")
        assert code == 1 and answer["kind"] == "unpaired", answer

        # With device.json beside it, the same refusal really does mean revoked.
        (Path(half.name) / "device.json").write_text('{"username": "zangetsu02"}')
        state.next_status = 401
        state.next_response = {"code": "device_not_approved", "message": "This key isn't approved."}
        answer, code = run_in(half.name, "me")
        assert code == 1 and answer["kind"] == "auth", answer
        half.cleanup()

        # Never paired is its own kind: the panel must not call it an error nor
        # count it toward "re-pair me". A missing key is not a refused device.
        bare_home = tempfile.TemporaryDirectory()
        answer, code = run_in(bare_home.name, "me")
        assert code == 1 and answer["kind"] == "unpaired", answer
        assert "setup-devnull" in answer["error"]
        bare_home.cleanup()

        print("read: all checks passed")
    finally:
        stop()
        tmp.cleanup()


if __name__ == "__main__":
    sys.exit(main())
